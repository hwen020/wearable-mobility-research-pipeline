# Default SQLite database stored locally (run from project root)
# DATABASE_URL=sqlite:///./mobility.db
# Optional MySQL (create database yourself and use a limited-privilege user):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mobility_research
# MAX_UPLOAD_BYTES=5242880
# STUDY_TIMEZONE=UTC
# DEMO_RESET_ENABLED=0
# DEMO_READ_ONLY=0
# Set all three to enable expected sampling coverage.
# GPS_WINDOW_START=2026-11-16T16:00:00Z
# GPS_WINDOW_END=2026-11-17T21:05:00Z
# GPS_EXPECTED_INTERVAL_SECONDS=300
